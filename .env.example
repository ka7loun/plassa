# Copy to .env.local (Next.js) and .env (scripts). Nothing here is a real secret.

# PostgreSQL with the contrib extensions pgcrypto, btree_gist, cube, earthdistance.
# Local default (npm run db:local): postgres://plassa:plassa@localhost:54329/plassa
DATABASE_URL=postgres://plassa:plassa@localhost:54329/plassa

# Used by the API integration tests (Vitest). The suite resets this database.
TEST_DATABASE_URL=postgres://plassa:plassa@localhost:54329/plassa_test

# Signs the session cookie (HS256). Use a long random value in any deploy.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
# DB_POOL_MAX=5                 # connections per server instance (default 20 local, 5 hosted)
# DB_SSL=false                  # turn off TLS for a non-local database without it
# BOOKING_RATE_PER_MIN=30       # bookings per user per minute
# NEXT_PUBLIC_MAP_STYLE=osm     # "osm" for raster OSM tiles, or a MapLibre style URL
